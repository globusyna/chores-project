# Copy this file to .env and fill in real values. .env is git-ignored.
# config/settings.py loads .env automatically on startup (manage.py and pytest).

# Django secret key. Required — settings raise ImproperlyConfigured without it.
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
